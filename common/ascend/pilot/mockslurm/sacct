#!/usr/bin/env python3
import os, sys
STATE=os.environ.get("MOCKSLURM_STATE","/tmp/mockslurm")
a=sys.argv[1:]; jid=None
for i,x in enumerate(a):
    if x=="-j": jid=a[i+1]
p=os.path.join(STATE,(jid or "")+".state")
if not jid or not os.path.exists(p): sys.exit(0)
st=open(p).read().strip()
ex=os.path.join(STATE,jid+".exit"); el=os.path.join(STATE,jid+".elapsed")
print("%s|%s|%s|%s|%s|1|None"%(jid, st,
    open(ex).read().strip() if os.path.exists(ex) else "0:0",
    open(el).read().strip() if os.path.exists(el) else "00:00:00", "1024K"))
