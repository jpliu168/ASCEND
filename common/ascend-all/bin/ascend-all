#!/usr/bin/env bash
# ASCEND-ALL — one front door for all three resources. Runs local Claude Code to
# reason about the job, probes what's free RIGHT NOW, recommends a resource, and
# on your OK hands off by launching that resource's front door.
#
#   ascend-all "train a 7B model for ~6 hours on one GPU"   # describe the job
#   ascend-all                                              # it will ask
#   ascend-all -d ~/proj "quick CUDA sanity check"          # set a project dir
#   ascend-all --probe                                      # just show the snapshot
#
# Resources: ncshare (Slurm H200, laptop-driven) · hazel-vcl (Slurm typed GPUs,
# agent on node) · hurricane (one Blackwell, no scheduler, agent on box).
set -Eeuo pipefail

SELF="$0"; while [ -h "$SELF" ]; do D="$(cd "$(dirname "$SELF")" && pwd)"; SELF="$(readlink "$SELF")"; case "$SELF" in /*) ;; *) SELF="$D/$SELF";; esac; done
BINDIR="$(cd "$(dirname "$SELF")" && pwd)"
PROBE="$BINDIR/ascend-probe"; [ -x "$PROBE" ] || PROBE="ascend-probe"

WORKDIR=""; JOB=""; PROBE_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    -d) WORKDIR="$2"; shift 2 ;;
    --probe) PROBE_ONLY=1; shift ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) JOB="${JOB:+$JOB }$1"; shift ;;
  esac
done

b()  { printf '\033[38;5;39m%s\033[0m\n' "$*"; }
dim(){ printf '\033[38;5;245m%s\033[0m\n' "$*"; }

# ---- NC STATE + DUKE banner (Wolfpack red 160 / Duke blue 26) -----------------
printf '\033]0;NC STATE + DUKE ASCEND-ALL\007'
echo
printf '    \033[1;38;5;160mNC STATE\033[0m   \033[38;5;245m+\033[0m   \033[1;38;5;26mDUKE\033[0m\n'
printf '\033[38;5;196m    ▄▀█ █▀ █▀▀ █▀▀ █▄░█ █▀▄\033[0m\n'
printf '\033[38;5;202m    █▀█ ▄█ █▄▄ ██▄ █░▀█ █▄▀\033[0m\n'
echo
printf '    \033[1mAI-powered Automation Scientific Computing and Discovery System\033[0m\n'
dim '    Autonomous Scientific Computing Engine for Novel Discovery (ASCEND)'
echo
# custom sites the user linked (./install.sh add) -> ~/.ascend/sites.json
CUSTOM_SITES=""
CUSTOM_PROFILES=""
if [ -f "$HOME/.ascend/sites.json" ]; then
  CUSTOM_SITES="$(python3 - <<'PY' 2>/dev/null || true
import json, os
try:
    reg = json.load(open(os.path.expanduser("~/.ascend/sites.json")))
    print(" ".join(sorted(k for k, v in reg.items() if isinstance(v, dict) and v.get("remote"))))
except Exception:
    pass
PY
)"
  CUSTOM_PROFILES="$(python3 - <<'PY' 2>/dev/null || true
import json, os
try:
    reg = json.load(open(os.path.expanduser("~/.ascend/sites.json")))
    for k in sorted(reg):
        v = reg[k]
        if not (isinstance(v, dict) and v.get("remote")): continue
        kind = v.get("kind", "cpu")
        prof = {"slurm": "Slurm cluster (custom, user-linked), agent on its login node, compute via sbatch/hpcrun. Jobs may queue; partitions/QOS unknown to you -- judge only by the live snapshot.",
                "gpu":   "GPU workstation (custom, user-linked), NO scheduler, agent on the box, zero queue. Judge VRAM/GPU count from the live snapshot's gpus list.",
                "cpu":   "CPU box (custom, user-linked), NO scheduler, agent on the box. CPU-only work."}[kind if kind in ("slurm","gpu","cpu") else "cpu"]
        print(f"- {k}: {v.get('desc','')} -- {prof}")
except Exception:
    pass
PY
)"
fi

ROUTELINE='    one front door — routing across ncshare · hazel · hurricane'
[ -n "$CUSTOM_SITES" ] && ROUTELINE="$ROUTELINE · $(printf '%s' "$CUSTOM_SITES" | sed 's/ / · /g')"
b   "$ROUTELINE"
dim '    Developed by NC State AI Hub for Science, OIT Advanced Computing, and Duke OIT Research Computing and Support Services.'
dim '    contact  Dr. Paul Liu: jpliu@ncsu.edu,  Andrew Petersen: aapeters@ncsu.edu; Uthpala Herath: uthpala.herath@duke.edu'
echo
dim "probing live availability..."
SNAP="$("$PROBE" --json 2>/dev/null || echo '{}')"
"$PROBE" 2>/dev/null || true

[ "$PROBE_ONLY" = "1" ] && exit 0

# ---- route loop: 0 at the confirm prompt returns here with a fresh query ----
while :; do
[ -n "$JOB" ] || { printf 'Describe the job (GPU? how long? how many/which GPUs? need it now?)\n' ; IFS= read -e -r -p '> ' JOB </dev/tty || true; }
[ -n "$JOB" ] || { echo "no job described; nothing to route (Ctrl-C to quit)." >&2; continue; }

# ---- ask LOCAL Claude Code to reason about the best resource -----------------
read -r -d '' POLICY <<'POL' || true
You are the ASCEND router. Pick ONE resource for the user's job from a live snapshot.
Resource profiles:
- hurricane: ONE RTX PRO 6000 Blackwell (~96 GB), NO scheduler, agent runs on the box, zero queue. Best for: one-GPU jobs that fit ~96 GB, interactive/short-to-medium, when you want it NOW and its GPU is free. Shared by courtesy.
- ncshare: Slurm cluster, H200 GPUs, laptop-driven (agent on the Mac, compute via proxy). Best for: batch/long single-GPU jobs, needing H200, or when hurricane is busy. Jobs may queue.
- hazel: NCSU Hazel Slurm cluster, typed GPUs, laptop-driven via the multiplexed login-node alias (scheduling + env builds only there; all compute via sbatch). Hazel has two GPU QOS options that trade wall-time against availability -- when hazel's snapshot entry is warm, its "sqos" field is this account's LIVE wall-time limit and GRES group cap per QOS (right now, not a remembered value), and "gpu_avail_short_gpu" / "gpu_avail_gpu_qos" are LIVE per-type GPU availability under each. Read the job's stated duration against sqos's own wall-time column yourself before recommending hazel for a QOS-bound job -- never assume either QOS's limit, it drifts. Best for: multi-GPU, a specific GPU type, a duration that doesn't fit hurricane/ncshare, or a very long queued job. Cold link needs one password+Duo first.
- local: no GPU needed and light -> just run on the Mac.
Custom sites may be appended below this policy block; treat each as a full
candidate under the same rules (its snapshot entry carries its live state).
Rules: match GPU need, VRAM, #GPUs, GPU type, and duration to the profile; for hazel, check the job's duration against its live sqos wall-time limits before recommending it, not an assumed number. Then break ties by the snapshot (free_now beats queued; a warm hazel beats a cold one for a quick job). If the job needs a GPU and hurricane.free_now and it fits one ~96 GB card and it is not a huge multi-GPU/very-long run, prefer hurricane. Needs H200 -> ncshare. Needs multi-GPU or a specific non-Blackwell type -> hazel, chosen against its live sqos/si data.
Output ONLY a single JSON object, no prose, no code fence:
{"resource":"hurricane|ncshare|hazel|local or a custom site name listed below","reason":"one sentence tying job nature + live availability","warnings":"empty or a caveat (e.g. hazel cold needs Duo; hurricane GPU busy)"}
POL
PROMPT="$POLICY
${CUSTOM_PROFILES:+
CUSTOM SITES (user-linked; also valid \"resource\" values):
$CUSTOM_PROFILES
}
LIVE SNAPSHOT (JSON): $SNAP

JOB: $JOB

Remember: output ONLY the JSON object."

dim "asking local Claude Code to choose..."
VERDICT="$(printf '%s' "$PROMPT" | claude -p 2>/dev/null || true)"

# ---- parse verdict (fall back to a deterministic rule if needed) ------------
DECISION="$(SNAP="$SNAP" JOB="$JOB" VERDICT="$VERDICT" python3 <<'PY'
import json, os, re
snap = json.loads(os.environ.get("SNAP") or "{}")
job  = os.environ.get("JOB","").lower()
v    = os.environ.get("VERDICT","")
res=reason=warn=None
m = re.search(r'\{.*\}', v, re.S)
if m:
    try:
        d=json.loads(m.group(0)); res=d.get("resource"); reason=d.get("reason"); warn=d.get("warnings")
    except Exception: pass
custom = {k: v for k, v in snap.items()
          if isinstance(v, dict) and v.get("custom")}
valid = ("hurricane","ncshare","hazel","local") + tuple(custom)
if res not in valid:
    # Deterministic fallback -- fires whenever the AI hand-off didn't return a
    # usable answer (claude -p failed, timed out, or returned non-JSON). It
    # MUST actually check live reachability for every candidate, not just the
    # ones a keyword happens to name -- an earlier version's final catch-all
    # hardcoded "hurricane" with no reachability check at all, so it could
    # recommend an unreachable resource while a genuinely available one
    # (hazel, most often) sat unexamined in the very snapshot it just took.
    gpu = any(k in job for k in ("gpu","cuda","train","inference","torch","model","fine-tune","finetune"))
    multi = any(k in job for k in ("multi-gpu","multi gpu","2 gpu","4 gpu","8 gpu","several gpu"))
    h200 = "h200" in job
    typed = any(k in job for k in ("h100","a100","l40"))
    long = any(k in job for k in ("hour","overnight","day","long","week"))
    hur = snap.get("hurricane",{}); nc = snap.get("ncshare",{}); hz = snap.get("hazel",{})
    hur_up = hur.get("reachable") or hur.get("free_now")
    nc_up  = nc.get("reachable")  or nc.get("free_now")
    hz_up  = hz.get("reachable")  or hz.get("warm") or hz.get("free_now")

    if not gpu:
        res, reason = "local", "no GPU needed — light enough for the Mac"
    elif (multi or typed) and hz_up:
        res, reason = "hazel", "needs multiple/typed GPUs — Hazel has them"
    elif h200 and nc_up:
        res, reason = "ncshare", "needs H200 — that's NCShare"
    elif hur.get("free_now") and not long:
        res, reason = "hurricane", "one-GPU job and hurricane's Blackwell is free now (no queue)"
    elif hz.get("free_now"):
        res, reason = "hazel", "Hazel is warm with idle/mixed GPU capacity available now"
    elif nc_up:
        res, reason = "ncshare", "NCShare reachable" + (" — H200s idle" if nc.get("free_now") else " (may queue)")
    elif hz_up:
        res, reason = "hazel", "Hazel reachable" + ("" if hz.get("free_now") else " (may queue)")
    elif hur_up:
        res, reason = "hurricane", "hurricane reachable but its GPU is busy — best remaining option"
    else:
        # custom sites as the remaining candidates: a free GPU box or Slurm
        # site for GPU jobs, any free/reachable site otherwise
        cand = None
        for want in (("gpu","slurm") if gpu else ("cpu","slurm","gpu")):
            for k in sorted(custom):
                v = custom[k]
                kind = "slurm" if "slurm" in str(v.get("kind","")).lower() else \
                       ("gpu" if "gpu" in str(v.get("kind","")).lower() else "cpu")
                if kind == want and v.get("free_now"):
                    cand = (k, "custom site '%s' is available now" % k); break
            if cand: break
        if not cand:
            for k in sorted(custom):
                if custom[k].get("reachable"):
                    cand = (k, "custom site '%s' reachable (may queue/share)" % k); break
        if cand:
            res, reason = cand
        else:
            res, reason = "hazel", "no resource's live status could be confirmed; defaulting to hazel -- verify manually before submitting"
    warn = warn or "AI hand-off did not return a usable answer; used the live-availability fallback rule, not model reasoning"
print(json.dumps({"resource":res,"reason":reason or "","warnings":warn or ""}))
PY
)"
RES="$(printf '%s' "$DECISION" | python3 -c 'import json,sys;print(json.load(sys.stdin)["resource"])')"
REASON="$(printf '%s' "$DECISION" | python3 -c 'import json,sys;print(json.load(sys.stdin)["reason"])')"
WARN="$(printf '%s' "$DECISION" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("warnings",""))')"

echo
b "  Recommendation: $RES"
dim "  why: $REASON"
[ -n "$WARN" ] && dim "  note: $WARN"
echo

# ---- confirm + hand off -----------------------------------------------------
printf 'Launch on %s? [Y/n, number/name to override, or 0 for a new query]\n' "$RES"
OVR='  override: \033[1m1)\033[0m \033[38;5;39mncshare\033[0m   \033[1m2)\033[0m \033[38;5;160mhazel\033[0m   \033[1m3)\033[0m \033[38;5;202mhurricane\033[0m   \033[1m4)\033[0m \033[38;5;28mlocal\033[0m'
N=4
for CS in $CUSTOM_SITES; do N=$((N+1)); OVR="$OVR   \033[1m$N)\033[0m \033[38;5;99m$CS\033[0m"; done
printf "$OVR   \033[1m0)\033[0m \033[38;5;245mnone \xe2\x80\x94 describe a different job\033[0m\n"
IFS= read -e -r -p '> ' ANS </dev/tty || true
PICKED=""
case "$ANS" in
  n|N) echo "cancelled."; exit 0 ;;
  0|none) JOB=""; echo; dim "ok — describe a different job (Ctrl-C to quit)."; continue ;;
  1) RES="ncshare" ;;
  2) RES="hazel" ;;
  3) RES="hurricane" ;;
  4) RES="local" ;;
  ncshare|vcl|hazel|hurricane|local) RES="$ANS" ;;
  ''|y|Y) : ;;  # accept recommendation
  *)
    # a custom site, by number (5+) or by name
    N=4
    for CS in $CUSTOM_SITES; do
      N=$((N+1))
      if [ "$ANS" = "$N" ] || [ "$ANS" = "$CS" ]; then PICKED="$CS"; break; fi
    done
    if [ -n "$PICKED" ]; then RES="$PICKED"
    else echo "unrecognized '$ANS' — keeping recommendation ($RES)"; fi ;;
esac
break
done
[ "$RES" = "hazel-vcl" ] && RES="hazel"; [ "$RES" = "vcl" ] && RES="hazel"

case "$RES" in
  hurricane) L=ascend-hurricane ;;
  ncshare)   L=ascend-ncshare ;;
  hazel)     if command -v ascend-hazel >/dev/null 2>&1; then L=ascend-hazel
             else L=ascend-vcl; fi ;;   # login-node launcher; fall back to the VCL model
  local)     dim "  running locally."; cd "${WORKDIR:-$PWD}"; exec claude ;;
  *)
    # a custom site registered in ~/.ascend/sites.json -> its own launcher
    OK=0
    for CS in $CUSTOM_SITES; do [ "$RES" = "$CS" ] && OK=1 && break; done
    [ "$OK" = "1" ] || { echo "unknown resource: $RES" >&2; exit 1; }
    L="ascend-$RES" ;;
esac
command -v "$L" >/dev/null || { echo "launcher '$L' not on PATH — is that resource installed?" >&2; exit 1; }
dim "  handing off to $L ..."
if [ -n "$WORKDIR" ]; then exec "$L" -d "$WORKDIR"; else exec "$L"; fi
