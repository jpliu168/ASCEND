#!/usr/bin/env bash
# paper-drop -- Mac-side companion to fetch-paper for papers the harness cannot
# fetch itself (Elsevier JS shells, bot-blocked publishers, anything paywalled).
#
# It turns the manual handoff into one command:
#   1. opens the DOI in your default browser (you -- or Claude in Chrome -- click "View PDF"),
#   2. waits for the new PDF to land in ~/Downloads,
#   3. pushes it to the cluster's papers dir over the (warm) ssh alias,
#   4. runs `fetch-paper <DOI> --register` THERE so it is verified and recorded
#      with MANUAL provenance -- the same audit trail as an automated fetch.
#
#   paper-drop 10.1016/j.margeo.2026.107879                   # -> hazel-vcl, $ASCEND_SCRATCH/papers on the node
#   paper-drop <DOI> --to <user>@login.ncshare.org --dir /work/<user>/papers
#   paper-drop <DOI> --file ~/Downloads/already-have.pdf      # skip the browser, just push+register
#   paper-drop <DOI> --no-open                                # don't open a browser; just wait for the file
#
# One paper per call, human in the loop. This is licensed personal access, not
# bulk collection -- never loop it over a bibliography. macOS bash 3.2.
set -Eeuo pipefail

DOI=""; TO="hazel-vcl"; DIR=""; FILE=""; OPEN=1; TIMEOUT=300
while [ $# -gt 0 ]; do
  case "$1" in
    --to) TO="$2"; shift 2 ;;
    --dir) DIR="$2"; shift 2 ;;
    --file) FILE="$2"; shift 2 ;;
    --no-open) OPEN=0; shift ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) DOI="$1"; shift ;;
  esac
done
[ -n "$DOI" ] || { echo "usage: paper-drop <DOI> [--to alias] [--dir remote-dir] [--file local.pdf] [--no-open]" >&2; exit 2; }
DOI="${DOI#https://doi.org/}"; DOI="${DOI#http://doi.org/}"

# same filename rule as fetch-paper: runs of disallowed chars -> "_"
BASE="$(printf '%s' "$DOI" | sed -E 's/[^A-Za-z0-9._-]+/_/g').pdf"
DL="$HOME/Downloads"

# the ssh link must already be warm (agents never answer Duo)
if ! ssh -o BatchMode=yes -o ConnectTimeout=10 "$TO" true 2>/dev/null; then
  echo "cannot reach '$TO' non-interactively. Warm it first:  ssh $TO   (password + Duo, once), then re-run." >&2
  exit 1
fi

# default remote papers dir = the NODE'S own ASCEND scratch (user-agnostic)
if [ -z "$DIR" ]; then
  DIR="$(ssh "$TO" 'echo "${ASCEND_SCRATCH:-/tmp}/papers"' 2>/dev/null || echo /tmp/papers)"
fi

if [ -z "$FILE" ]; then
  # snapshot existing PDFs so we only accept a NEW one
  before="$(ls -1 "$DL"/*.pdf 2>/dev/null || true)"
  if [ "$OPEN" = "1" ]; then
    echo "==> opening https://doi.org/$DOI in your browser -- click 'View PDF' / download (save to ~/Downloads)"
    open "https://doi.org/$DOI"
  else
    echo "==> waiting for a new PDF in ~/Downloads for DOI $DOI"
  fi
  echo "    waiting up to ${TIMEOUT}s for the download to finish..."
  t=0
  while [ "$t" -lt "$TIMEOUT" ]; do
    sleep 2; t=$((t+2))
    # still-downloading markers from Chrome/Firefox/Safari
    if ls "$DL"/*.crdownload "$DL"/*.part "$DL"/*.download >/dev/null 2>&1; then continue; fi
    now="$(ls -1t "$DL"/*.pdf 2>/dev/null || true)"
    newest="$(printf '%s\n' "$now" | head -1)"
    [ -n "$newest" ] || continue
    if ! printf '%s\n' "$before" | grep -qxF "$newest"; then
      s1=$(stat -f %z "$newest"); sleep 2; s2=$(stat -f %z "$newest")
      [ "$s1" = "$s2" ] && [ "$s1" -gt 10240 ] && { FILE="$newest"; break; }
    fi
  done
  [ -n "$FILE" ] || { echo "no new PDF appeared in ~/Downloads within ${TIMEOUT}s -- nothing pushed." >&2; exit 1; }
fi

head -c 5 "$FILE" | grep -q '%PDF' || { echo "$FILE does not start with %PDF -- refusing to push it as the paper." >&2; exit 1; }
echo "==> got: $FILE ($(du -h "$FILE" | cut -f1))"
echo "==> pushing to $TO:$DIR/$BASE"
ssh "$TO" "mkdir -p '$DIR'"
rsync -a --progress "$FILE" "$TO:$DIR/$BASE" | tail -1
echo "==> registering on $TO (verification + MANUAL provenance)"
ssh "$TO" "bash -lc \"fetch-paper '$DOI' --register '$DIR/$BASE' --out '$DIR'\""
