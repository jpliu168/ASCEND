#!/usr/bin/env python3
"""Mirrors real NCShare sinfo output (probed 2026-08-23), including the
one-row-per-(partition,state) shape and full-width state names."""
import sys
fmt = " ".join(sys.argv[1:])
if "%20T" in fmt:
    rows = [("common",  "mixed",4),("common","allocated",3),
            ("interactive","mixed",5),("interactive","allocated",3),
            ("gpu","mixed",3),("gpu","mixed",1),
            ("interactive-gpu","mixed",3),("interactive-gpu","mixed",1),
            ("gpu-hp","mixed",3),("gpu-hp","mixed",1),
            ("osg","mixed",5),("osg","allocated",3)]
    for p,s,n in rows: print("%s|%s|%d" % (p,s,n))
    raise SystemExit
G="gpu:h200:8(S:0-1)"
rows=[("common*","up","7-00:00:00",5,64,257000,"(null)","cpu"),
      ("common*","up","7-00:00:00",3,64,257000,"(null)","cpu"),
      ("interactive","up","1:00:00",8,64,257000,"(null)","cpu"),
      ("gpu","up","2-00:00:00",4,64,515000,G,"h200"),
      ("interactive-gpu","up","1:00:00",4,64,515000,G,"h200"),
      ("gpu-hp","up","30-00:00:00",4,64,515000,G,"h200"),
      ("osg","up","7-00:00:00",8,64,257000,"(null)","cpu")]
for r in rows: print("|".join(str(x) for x in r))
