#!/usr/bin/env bash
# ASCEND-HAZEL — the ASCEND front door for NC State Hazel, running on the Mac.
#
# The agent (Claude Code) runs locally with your Mac's skills, network and
# login; Hazel work is routed per-command through the multiplexed ssh alias
# `hazel` (login.hpc.ncsu.edu). The login node is used ONLY for Slurm
# scheduling and environment builds — all real compute goes through sbatch.
#
#   ascend-hazel                    # start in the current directory
#   ascend-hazel -d ~/myproj       # start in a specific project
#   ascend-hazel --check           # test the hazel link and exit
#
# The alias needs a warm ControlMaster socket (password + Duo once per 8h):
# warm it with a plain `ssh hazel` in another terminal.
# Written for macOS bash 3.2.
set -Eeuo pipefail

# Resolve the real script location even when invoked via the ~/.local/bin symlink
SRC="$0"
while [ -h "$SRC" ]; do
  D="$(cd "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$D/$SRC" ;; esac
done
BUNDLE="$(cd "$(dirname "$SRC")/.." && pwd)"
WORKDIR="${ASCEND_HAZEL_PROJECT_DIR:-$HOME/agents/ncsuhpc/projects-hazel}"
if [ -f "$PWD/AGENTS.md" ] || [ -f "$PWD/CLAUDE.md" ]; then WORKDIR="$PWD"; fi
CHECK=0
ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    -d) WORKDIR="$2"; shift 2 ;;
    --check) CHECK=1; shift ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; while [ $# -gt 0 ]; do ARGS[${#ARGS[@]}]="$1"; shift; done ;;
    *) ARGS[${#ARGS[@]}]="$1"; shift ;;
  esac
done

b()  { printf '\033[38;5;160m%s\033[0m\n' "$*"; }   # WOLFPACK red
dim(){ printf '\033[38;5;245m%s\033[0m\n' "$*"; }

if [ "$CHECK" = "1" ]; then
  echo "Checking the hazel link (ControlMaster socket probe — local, never connects)..."
  if ssh -O check hazel >/dev/null 2>&1; then
    echo "  link: WARM"
    printf '  login node: '
    out=$(ssh hazel 'hostname && echo OK' 2>&1) \
      && echo "OK — $(printf '%s' "$out" | head -1)" \
      || { echo "FAILED"; printf '%s\n' "$out" | sed 's/^/      /'; }
    printf '  slurm:      '
    ssh hazel 'sinfo --version' 2>/dev/null || echo "sinfo failed"
    printf '  tools:      '
    ssh hazel 'ls ~/bin/hpcrun ~/bin/hpcrepro 2>/dev/null | tr "\n" " "; echo' \
      || echo "(hpcrun/hpcrepro not found in ~/bin)"
  else
    echo "  link: COLD — no ControlMaster socket."
    echo "  Warm it in another terminal:  ssh hazel   (password + Duo, then persists 8h)"
    echo "  Then re-run:  ascend-hazel --check"
    exit 1
  fi
  exit 0
fi

CCV="$(claude --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
[ -n "$CCV" ] && CCV="Claude Code v$CCV" || { echo "claude is not on PATH." >&2; exit 1; }
if [ ! -d "$WORKDIR" ]; then
  echo "creating workdir: $WORKDIR"
  mkdir -p "$WORKDIR" || { echo "cannot create workdir: $WORKDIR" >&2; exit 1; }
fi

printf '\033]0;WOLFPACK ASCEND-HAZEL — %s\007' "${WORKDIR##*/}"
echo
b '    WOLFPACK'
b '    ▄▀█ █▀ █▀▀ █▀▀ █▄░█ █▀▄'
b '    █▀█ ▄█ █▄▄ ██▄ █░▀█ █▄▀'
echo
printf '    \033[1mNC State AI-powered Automation Scientific Computing and Discovery System\033[0m\n'
dim "    Autonomous Scientific Computing Engine for Novel Discovery   ($CCV)"
echo
dim "    workdir  $WORKDIR"
dim "    cluster  ssh hazel '<cmd>' — login node: scheduling + env builds ONLY"
dim "    compute  sbatch via hpcrun (typed gres mandatory); ~/bin on Hazel"
echo
dim "    Developed by NC State AI Hub for Science and OIT Advanced Computing team"
dim "    contact   Dr. Paul Liu: jpliu@ncsu.edu, or Andrew Petersen: aapeters@ncsu.edu"
# Warm/cold link (ControlMaster socket; cold needs password + Duo to warm)
if ssh -O check hazel >/dev/null 2>&1; then
  dim "    link     warm — hazel commands run without prompts"
else
  dim "    link     COLD — warm it first in another terminal:  ssh hazel"
fi
echo

# Ensure the project carries the ASCEND-HAZEL instructions and statusline.
if [ ! -f "$WORKDIR/AGENTS.md" ] && [ ! -f "$WORKDIR/CLAUDE.md" ]; then
  # Resolve the Unity ID from the hazel alias (else $USER) and substitute it
  # so /share/<user> and squeue -u <user> are correct.
  UNITYID="$(awk '/^Host hazel$/{b=1;next} b&&/^Host /{b=0} b&&$1=="User"{print $2;exit}' "$HOME/.ssh/config" 2>/dev/null)"
  UNITYID="${UNITYID:-$USER}"
  sed "s/@@UNITYID@@/$UNITYID/g" "$BUNDLE/AGENTS-hazel-template.md" > "$WORKDIR/AGENTS.md"
  dim "    (added AGENTS.md to this project from the ascend-hazel template; user=$UNITYID)"
fi
if [ ! -f "$WORKDIR/.claude/settings.json" ]; then
  mkdir -p "$WORKDIR/.claude"
  printf '{\n  "statusLine": { "type": "command", "command": "~/.claude/ascend-hazel-statusline.sh" }\n}\n' \
    > "$WORKDIR/.claude/settings.json"
fi

cd "$WORKDIR"
exec claude ${ARGS[@]+"${ARGS[@]}"}
